{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Afterglow",
  "version": "0.1.0",
  "identifier": "io.afterglow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Afterglow · 续温",
        "decorations": false,
        "width": 1200,
        "height": 830,
        "minWidth": 800,
        "minHeight": 620,
        "backgroundColor": "#F5F1E4",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../desktop_host/": "desktop_host/",
      "../locales/": "locales/",
      "resources/runtime-catalog.json": "catalog.json",
      "resources/python/": "python/",
      "resources/packages/": "packages/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    }
  }
}
